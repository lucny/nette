{block content}
<div class="page-heading"><div><p class="eyebrow">Produkty</p><h1 n:block=title>Nový produkt</h1></div></div>
<div class="form-card"><form n:name=productForm class="product-form"><div class="form-grid"><div n:foreach="$form->controls as $control" n:if="$control->name !== 'save'">{label $control /}{input $control}{if $control->error}<small class="error">{$control->error}</small>{/if}</div></div><div class="actions"><button class="button" n:name=save>Přidat produkt</button><a class="button secondary" n:href="default">Zpět</a></div></form></div>
