{block content}
<div class="page-heading"><div><p class="eyebrow">Produkty</p><h1 n:block=title>Upravit produkt</h1></div></div>
<div class="form-card"><form n:name=productForm class="product-form"><div class="form-grid"><div n:foreach="$form->controls as $field" n:if="$field->name !== 'save'">{label $field /}{input $field}{if $field->error}<small class="error">{$field->error}</small>{/if}</div></div><div class="actions"><button class="button" n:name=save>Uložit změny</button><a class="button secondary" n:href="default">Zpět</a></div></form></div>
