# see https://doc.nette.org/en/configuring

parameters:
	database:
		dsn: 'mysql:host=127.0.0.1;dbname=nette_products;charset=utf8mb4'
		user: root
		password: ''


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\Presentation\*\**Presenter


database:
	dsn: %database.dsn%
	user: %database.user%
	password: %database.password%


security:
	authentication:
		storage: session
		expiration: 30 minutes


latte:
	strictParsing: yes
	extensions:
		- App\Presentation\Accessory\LatteExtension


assets:
	mapping:
		default:
			path: assets
			# type: vite  # Uncomment to activate Vite for asset building


di:
	export:
		parameters: no
		tags: no
